# FastAPI migration service
APP_NAME=AT Connect
APP_ENV=development
HOST=127.0.0.1
PORT=7000
LOG_LEVEL=INFO

MONGODB_URI=mongodb://127.0.0.1:27017/peoplepulse_hr
MONGODB_DATABASE=peoplepulse_hr
REDIS_URL=redis://127.0.0.1:6379/0

JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_MINUTES=15
JWT_ISSUER=at-connect-api
JWT_AUDIENCE=at-connect-web
REFRESH_TOKEN_SECRET=replace-with-another-unique-random-secret-at-least-32-characters
REFRESH_TOKEN_EXPIRES_DAYS=7

CLIENT_URLS=http://127.0.0.1:7173,http://localhost:7173
OTP_EXPIRES_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_EMAILS_ENABLED=false

SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@peoplepulse.local
SEED_ADMIN_PASSWORD=ChangeMe123!

MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
MAIL_SENDER_EMAIL=
MAIL_FROM_NAME=AT Connect
MAIL_REPLY_TO=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MANUAL_ATTENDANCE_REVIEW_THRESHOLD=3
MANUAL_ATTENDANCE_FACE_RETRY_LIMIT=2
MANUAL_ATTENDANCE_ALLOW_LOCATION_EXCEPTION=true

# UniFace server-side identity engine. Calibrate thresholds before production rollout.
FACE_ENGINE=uniface
FACE_DETECTOR=scrfd_10g
FACE_RECOGNIZER=arcface_mnet
FACE_MODEL_VERSION=uniface-3.7.1-scrfd10g-arcface-mnet
FACE_MATCH_THRESHOLD=0.45
FACE_MIN_QUALITY=0.30
FACE_ANTI_SPOOF_ENABLED=false
FACE_ANTI_SPOOF_THRESHOLD=0.80
FACE_CHALLENGE_EXPIRY_SECONDS=30
FACE_ENROLLMENT_CHALLENGE_EXPIRY_SECONDS=300
FACE_VERIFICATION_EXPIRY_SECONDS=90
FACE_MAX_RETRIES=2
FACE_EMBEDDING_KEY=
FACE_MODEL_CACHE_DIR=
ACCEPT_LEGACY_ACCESS_TOKENS=true

# Legacy Express variables retained until module parity is complete.
NODE_ENV=development
JWT_EXPIRES_IN=8h
CLIENT_URL=http://127.0.0.1:7173
